{
  "name": "omnipdf",
  "private": true,
  "version": "0.3.0",
  "description": "OmniPDF Pro Suite - Complete PDF & Media Processing Tools",
  "author": "OmniPDF Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "start": "concurrently \"npm run dev\" \"npm run server\"",
    "lint": "node --check server/index.js server/routes/api.js server/middleware/security.js",
    "test": "node server/test/health.test.js",
    "electron:dev": "concurrently -k \"cross-env PORT=8091 npm run dev\" \"wait-on tcp:8091 && cross-env VITE_DEV_SERVER_URL=http://localhost:8091 electron .\"",
    "electron:build:win": "npm run build && electron-builder --win",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "@imgly/background-removal": "^1.5.5",
    "@xenova/transformers": "^2.17.2",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^9.1.0"
  }
}
