{
  "appId": "com.omnipdf.desktop",
  "productName": "OmniPDF",
  "copyright": "Copyright © 2026 UG_SIDHARTH. All rights reserved.",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-server/**/*",
    "electron/**/*",
    "server/**/*",
    "package.json",
    "public/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "role": "Editor"
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "OmniPDF Pro"
  }
}
